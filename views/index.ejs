
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LexStore | Tienda de Recursos Jurídicos</title>
    <link rel="stylesheet" href="../styles/style.css">
</head>
<body>
    <header class="header-main">
        <div class="logo">
            <h1>LexStore</h1>
        </div>
        <nav class="navbar">
            <ul>
                <li><a href="index.html">Inicio</a></li>
                <li><a href="register.html">Crear Cuenta</a></li>
                <li><a href="login.html">Ingresar</a></li>
                <li><a href="productCart.html">Mi Carrito</a></li>
            </ul>
        </nav>
    </header>

    <main class="container">
        <section class="banner-promocional">
            <h2>Actualizá tu biblioteca jurídica</h2>
            <p>Encontrá los mejores libros, códigos comentados y modelos de escritos.</p>
        </section>

        <section class="productos-destacados">
            <h2>Novedades Destacadas</h2>
            <div class="grid-productos">
                
                <!-- Producto 1 -->
                <article class="card-producto">
                    <img src="/img/codigo-civil.jpg" alt="Código Civil y Comercial Comentado">
                    <div class="info-producto">
                        <h3>Código Civil y Comercial Comentado</h3>
                        <p class="formato">Libro Físico - Edición 2026</p>
                        <p class="precio">$45.000</p>
                        <a href="productDetail.html" class="btn-detalle">Ver detalles</a>
                    </div>
                </article>

                <!-- Producto 2 -->
                <article class="card-producto">
                    <img src="/img/modelo-locacion.jpg" alt="Modelo Contrato de Locación">
                    <div class="info-producto">
                        <h3>Modelo: Contrato de Locación</h3>
                        <p class="formato">Plantilla Word Editable</p>
                        <p class="precio">$8.500</p>
                        <a href="productDetail.html" class="btn-detalle">Ver detalles</a>
                    </div>
                </article>

            </div>
        </section>
    </main>

    <footer class="footer-main">
        <p>&copy; 2026 LexStore. Proyecto de desarrollo web.</p>
    </footer>
</body>
</html>
