<%- include('../partials/head') %>

<body>
    <%- include('../partials/header') %>

    <main class="container">
        <section class="form-section">
            <h2>Editar Producto</h2>
            <form action="/products/edit" method="POST" enctype="multipart/form-data">
                <div>
                    <label for="name">Nombre del recurso:</label>
                    <input type="text" id="name" name="name" value="Código Civil y Comercial Comentado" required>
                </div>
                <div>
                    <label for="description">Descripción:</label>
                    <textarea id="description" name="description" required>Edición actualizada con jurisprudencia reciente.</textarea>
                </div>
                <div>
                    <label for="image">Imagen actual / Cambiar imagen:</label>
                    <input type="file" id="image" name="image">
                </div>
                <div>
                    <label for="category">Categoría:</label>
                    <select id="category" name="category">
                        <option value="libros">Libros</option>
                        <option value="codigos" selected>Códigos Comentados</option>
                        <option value="modelos">Modelos de Escritos</option>
                    </select>
                </div>
                <div>
                    <label for="price">Precio:</label>
                    <input type="number" id="price" name="price" value="10000" required>
                </div>
                <button type="submit">Actualizar Producto</button>
            </form>
        </section>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
