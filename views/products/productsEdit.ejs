<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Editar Producto</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Formulario de Edición de Producto</h1>
    <form action="/products/<%= product.id %>?_method=PUT" method="POST" enctype="multipart/form-data">
        
        <div>
            <label for="name">Nombre del producto:</label>
            <input type="text" id="name" name="name" value="<%= locals.oldData && oldData.name ? oldData.name : product.name %>">
            <% if (locals.errors && errors.name) { %>
                <div style="color: red; font-size: 12px; margin-top: 5px;"><%= errors.name.msg %></div>
            <% } %>
        </div>

        <div>
            <label for="category_id">Categoría:</label>
            <select id="category_id" name="category_id">
                <option value="" disabled>Seleccione una categoría</option>
                <% categories.forEach(category => { %>
                    <option value="<%= category.id %>" 
                        <%= (locals.oldData && oldData.category_id == category.id) || (!locals.oldData && product.category_id == category.id) ? 'selected' : '' %>>
                        <%= category.name %>
                    </option>
                <% }) %>
            </select>
            <% if (locals.errors && errors.category_id) { %>
                <div style="color: red; font-size: 12px; margin-top: 5px;"><%= errors.category_id.msg %></div>
            <% } %>
        </div>

        <div>
            <label for="price">Precio:</label>
            <input type="number" id="price" name="price" value="<%= locals.oldData && oldData.price ? oldData.price : product.price %>">
            <% if (locals.errors && errors.price) { %>
                <div style="color: red; font-size: 12px; margin-top: 5px;"><%= errors.price.msg %></div>
            <% } %>
        </div>

        <div>
            <label for="description">Descripción:</label>
            <textarea id="description" name="description"><%= locals.oldData && oldData.description ? oldData.description : product.description %></textarea>
            <% if (locals.errors && errors.description) { %>
                <div style="color: red; font-size: 12px; margin-top: 5px;"><%= errors.description.msg %></div>
            <% } %>
        </div>

        <div>
            <label for="image">Imagen del producto (opcional):</label>
            <input type="file" id="image" name="image">
            <input type="hidden" name="oldImage" value="<%= product.image %>">
            <% if (locals.errors && errors.image) { %>
                <div style="color: red; font-size: 12px; margin-top: 5px;"><%= errors.image.msg %></div>
            <% } %>
        </div>

        <button type="submit">Modificar Producto</button>
    </form>
    <br>
    <a href="/products">Volver al listado</a>
    <script src="/js/productValidation.js"></script>
</body>
</html>