<%- include('../partials/head') %>

<body>
    <%- include('../partials/header') %>

    <main class="container">
        <section class="login-section">
            <h2>Iniciar Sesión</h2>
            <form action="/users/login" method="POST">
                <div>
                    <label for="email">Correo electrónico:</label>
                    <input type="email" id="email" name="email" value="<%= locals.oldData && oldData.email ? oldData.email : '' %>">
                    <% if (locals.errors && errors.email) { %>
                        <div style="color: red; font-size: 12px; margin-top: 5px;"><%= errors.email.msg %></div>
                    <% } %>
                </div>
                <div>
                    <label for="password">Contraseña:</label>
                    <input type="password" id="password" name="password">
                    <% if (locals.errors && errors.password) { %>
                        <div style="color: red; font-size: 12px; margin-top: 5px;"><%= errors.password.msg %></div>
                    <% } %>
                </div>
                <button type="submit">Ingresar</button>
            </form>
        </section>
    </main>

    <%- include('../partials/footer') %>
    <script src="/js/loginValidation.js"></script>
</body>
</html>